<?xml version="1.0" encoding="utf-8"?>
<com.android.mmt.ui.SizeAwareLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contact_panel"
    android:background="@drawable/title_bar_bg_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/item_horizontal_padding"
    android:layout_marginEnd="@dimen/item_horizontal_padding">
    <TextView
        android:textSize="@dimen/new_message_label_text_size"
        android:textColor="@color/new_message_label_color"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/recipient_label"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/new_message_contact_margin"/>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:background="@drawable/recipients_editor_view_bg"
        android:addStatesFromChildren="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <ScrollView
            android:layout_gravity="center_vertical"
            android:id="@+id/recipient_rows_scroller"
            android:fadingEdge="none"
            android:addStatesFromChildren="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never">
            <com.android.mmt.ui.RowLayout xmlns:mms="http://schemas.android.com/apk/res/com.android.mmt"
                android:id="@+id/recipient_rows"
                android:addStatesFromChildren="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                mms:horizontalSpacing="@dimen/recipient_row_padding"
                mms:verticalSpacing="@dimen/recipient_row_padding">
                <EditText
                    android:textColorHint="@color/miuix_appcompat_transparent"
                    android:gravity="center_vertical"
                    android:id="@+id/recipients_editor"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="30dp"
                    android:minHeight="25dp"
                    android:hint="@string/recipient_label"
                    android:maxLines="4"
                    style="@style/TextAppearance.EditText.Recipient"/>
            </com.android.mmt.ui.RowLayout>
        </ScrollView>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/recipients_viewer_linear"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="@style/TextAppearance.EditText.Recipient"
                android:gravity="center_vertical"
                android:id="@+id/recipients_viewer"
                android:background="@drawable/recipient_editor_bg"
                android:focusable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"
                android:contentDescription="@string/recipient_label"/>
            <TextView
                android:textAppearance="@style/TextAppearance.EditText.Recipient"
                android:gravity="center_vertical"
                android:id="@+id/recipients_viewer_count"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/new_message_contact_margin"
        android:layout_marginEnd="@dimen/add_recipients_margin">
        <ImageView
            android:id="@+id/add_recipient"
            android:padding="4dp"
            android:layout_width="@dimen/contact_pick_icon_size"
            android:layout_height="@dimen/contact_pick_icon_size"
            android:src="@drawable/ic_add_contact"
            android:contentDescription="@string/select_recipient"/>
        <Button
            android:id="@+id/confirm_recipient"
            android:background="@drawable/ic_confirm_recipient"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/confirm"/>
        <TextView
            android:textAppearance="@style/TextAppearance.EditText.Recipient"
            android:id="@+id/recipient_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/new_message_contact_margin"/>
    </LinearLayout>
</com.android.mmt.ui.SizeAwareLinearLayout>
