<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/message_item_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/with_banner_message_item"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/bubble_margin"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ad_banner_image_height"
            android:scaleType="fitXY"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/message_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/bubble_special_margin">
            <com.android.mmt.ui.ThumbnailView
                android:id="@+id/attachment_preview"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginRight="@dimen/bubble_item_attachment_preview_margin"
                android:layout_marginBottom="8dp"
                android:layout_alignParentLeft="true"
                android:contentDescription="@string/type_picture"/>
            <include
                android:id="@+id/bubble_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/attachment_preview"
                layout="@layout/message_item_bubble_in_body"/>
            <View
                android:id="@+id/mms_download_padding_view"
                android:background="@null"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="false"
                android:longClickable="false"
                android:layout_width="@dimen/mms_download_padding_width"
                android:layout_height="1px"
                android:layout_toRightOf="@+id/bubble_body"/>
            <FrameLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/message_understand_button_height"
                android:layout_marginTop="@dimen/message_understand_button_top_margin"
                android:layout_marginBottom="@dimen/message_understand_button_bottom_margin"
                android:layout_below="@+id/bubble_body"
                android:layout_alignLeft="@+id/bubble_body"
                android:layout_alignRight="@+id/bubble_body"/>
            <ViewStub
                android:id="@+id/audio_item_stub"
                android:layout="@layout/audio_item_panel_in"
                android:layout_width="@dimen/audio_bubble_width"
                android:layout_height="@dimen/audio_bubble_height"/>
        </RelativeLayout>
    </LinearLayout>
    <ViewStub
        android:id="@+id/mms_download_controls"
        android:layout="@layout/message_item_bubble_download_controls"
        android:layout_width="@dimen/mms_download_padding_width"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="@+id/with_banner_message_item"
        app:layout_constraintRight_toRightOf="@+id/with_banner_message_item"
        app:layout_constraintTop_toTopOf="@+id/with_banner_message_item"/>
    <ViewStub
        android:gravity="center_vertical"
        android:id="@+id/audio_readed_stub"
        android:layout="@layout/audio_readed_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/audio_unread_dot_margin_left"
        android:layout_marginTop="@dimen/audio_unread_dot_margin_top"
        app:layout_constraintLeft_toRightOf="@+id/with_banner_message_item"/>
    <ViewStub
        android:id="@+id/favorite_and_rcs_progress_layout"
        android:layout="@layout/message_item_bubble_favrite_and_rcs"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/with_banner_message_item"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintLeft_toRightOf="@+id/with_banner_message_item"
        app:layout_constraintTop_toTopOf="@+id/with_banner_message_item"/>
</androidx.constraintlayout.widget.ConstraintLayout>
