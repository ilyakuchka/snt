<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:gravity="start|top"
        android:id="@+id/new_phrase_content"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="150dp"
        android:hint="@string/new_phrase_hint"
        android:minLines="4"
        android:singleLine="false"
        android:layout_marginStart="@dimen/new_phrase_content_margin_start"
        android:layout_marginEnd="@dimen/new_phrase_content_margin_start"
        style="@style/TextAppearance.EditText.Dialog"/>
</FrameLayout>
