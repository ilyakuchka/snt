<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/sim_button_container"
        android:background="@drawable/sim_button_container_bg"
        android:layout_width="@dimen/sim_button_container_width"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/sim_button1"
            android:background="@drawable/send_slot_btn_bg_top"
            android:paddingTop="20dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:clickable="true"
            android:clipChildren="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/sim_button_container_height"
            android:layout_weight="1">
            <ImageButton
                android:background="@drawable/sim1"
                android:clickable="false"
                android:layout_width="@dimen/sim_button_image_width"
                android:layout_height="@dimen/sim_button_image_height"
                android:importantForAccessibility="no"
                android:layout_marginStart="@dimen/sim_button_image_margin_start"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/sim_button1_text_min_width"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:gravity="start"
                    android:id="@+id/sim_button1_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sim_card1"
                    style="@style/SimIndicatorTextStyle"/>
                <TextView
                    android:id="@+id/sim_button1_number"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textDirection="firstStrongLtr"
                    style="@style/SimIndicatorNumberStyle"/>
            </LinearLayout>
            <View
                android:id="@+id/sim_button1_choose"
                android:background="@drawable/ic_select"
                android:layout_width="@dimen/sim_button_choose_width"
                android:layout_height="@dimen/sim_button_choose_height"
                android:layout_marginEnd="20dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/sub_sim_button1"
            android:background="@drawable/send_slot_btn_bg_middle"
            android:paddingTop="20dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sim_button_container_height"
            android:layout_weight="1">
            <TextView
                android:id="@+id/sub_sim_button1_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_sim_card"
                android:drawableStart="@drawable/sub_sim1"
                style="@style/SimIndicatorTextStyle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sim_button2"
            android:background="@drawable/send_slot_btn_bg_bottom"
            android:paddingTop="12dp"
            android:paddingBottom="20dp"
            android:focusable="true"
            android:clickable="true"
            android:clipChildren="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/sim_button_container_height"
            android:layout_weight="1">
            <ImageButton
                android:background="@drawable/sim2"
                android:clickable="false"
                android:layout_width="@dimen/sim_button_image_width"
                android:layout_height="@dimen/sim_button_image_height"
                android:importantForAccessibility="no"
                android:layout_marginStart="@dimen/sim_button_image_margin_start"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/sim_button1_text_min_width"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:gravity="start"
                    android:id="@+id/sim_button2_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sim_card2"
                    style="@style/SimIndicatorTextStyle"/>
                <TextView
                    android:id="@+id/sim_button2_number"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textDirection="firstStrongLtr"
                    style="@style/SimIndicatorNumberStyle"/>
            </LinearLayout>
            <View
                android:id="@+id/sim_button2_choose"
                android:background="@drawable/ic_select"
                android:layout_width="@dimen/sim_button_choose_width"
                android:layout_height="@dimen/sim_button_choose_height"
                android:layout_marginEnd="20dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/sub_sim_button2"
            android:background="@drawable/send_slot_btn_bg_bottom"
            android:paddingTop="12dp"
            android:paddingBottom="20dp"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sim_button_container_height"
            android:layout_weight="1">
            <TextView
                android:id="@+id/sub_sim_button2_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sub_sim_card"
                android:drawableStart="@drawable/sub_sim2"
                style="@style/SimIndicatorTextStyle"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
