<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/bubble_text_extra_padding"
    android:layout_marginStart="@dimen/bubble_text_extra_padding"
    android:layout_marginEnd="@dimen/bubble_text_extra_padding">
    <TextView
        android:id="@+id/group_message_failed_title"
        android:background="@drawable/group_item_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        style="@style/TextAppearance.MessageBody.Alert.Secondary"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/group_message_failed_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="2.5dp">
        <Button
            android:id="@+id/group_btn_resend"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/MessageButton.Alert"/>
        <Button
            android:id="@+id/group_btn_nosend"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nosend_message"
            android:layout_marginStart="5dp"
            style="@style/MessageButton.Alert"/>
    </LinearLayout>
</LinearLayout>
