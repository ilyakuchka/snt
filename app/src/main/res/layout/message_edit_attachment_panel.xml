<?xml version="1.0" encoding="utf-8"?>
<ViewSwitcher xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attachment_panel"
    android:background="@drawable/attachment_screen_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/attachment_type_screen_height"
    android:measureAllChildren="false">
    <com.android.mmt.ui.AttachmentScreenView
        android:id="@+id/attachment_type_screens"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/attachment_type_screens_space"/>
    <ViewStub
        android:id="@+id/message_edit_smiley_panel_stub"
        android:layout="@layout/message_edit_smiley_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</ViewSwitcher>
