<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/train_number_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/card_railway"
        android:scaleType="centerInside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_info_text_size"
        android:textColor="@color/normal_card_text_secondary"
        android:id="@+id/ticket_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/travel_card_date_margin_start"
        app:layout_constraintBottom_toBottomOf="@+id/train_number_icon"
        app:layout_constraintStart_toEndOf="@+id/train_number_icon"
        app:layout_constraintTop_toTopOf="@+id/train_number_icon"/>
    <TextView
        android:textSize="@dimen/travel_card_info_text_size"
        android:textColor="@color/normal_card_text_secondary"
        android:id="@+id/travel_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/travel_card_date_margin_start"
        app:layout_constraintBottom_toBottomOf="@+id/ticket_type"
        app:layout_constraintStart_toEndOf="@+id/ticket_type"
        app:layout_constraintTop_toTopOf="@+id/ticket_type"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_info_text_size"
        android:textColor="@color/normal_card_text_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/travel_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/travel_status"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_station_text_size"
        android:textStyle="bold"
        android:textColor="@color/normal_card_text_primary"
        android:id="@+id/from_station"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_station_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/from_time"
        style="@style/smart_card_normal_text"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_time_text_size"
        android:textColor="@color/normal_card_text_primary"
        android:ellipsize="end"
        android:id="@+id/from_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_time_margin_top"
        android:maxLength="5"
        android:fontFamily="mitype-semibold"
        app:layout_constraintStart_toStartOf="@+id/train_number_icon"
        app:layout_constraintTop_toBottomOf="@+id/train_number_icon"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_info_text_size"
        android:textColor="@color/normal_card_text_secondary"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/train_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxEms="5"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/from_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/from_time"/>
    <ImageView
        android:layout_width="@dimen/travel_card_from_to_icon_width"
        android:layout_height="@dimen/travel_card_from_to_icon_height"
        android:layout_marginTop="@dimen/travel_card_from_to_icon_margin_top"
        android:src="@drawable/card_travel_to"
        android:scaleType="centerInside"
        app:layout_constraintEnd_toEndOf="@+id/train_number"
        app:layout_constraintStart_toStartOf="@+id/train_number"
        app:layout_constraintTop_toBottomOf="@+id/train_number"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_station_text_size"
        android:textStyle="bold"
        android:textColor="@color/normal_card_text_primary"
        android:id="@+id/arrive_station"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/from_station"
        style="@style/smart_card_normal_text"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_time_text_size"
        android:textColor="@color/normal_card_text_primary"
        android:id="@+id/arrive_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLength="5"
        android:fontFamily="mitype-semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/from_time"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_item_secondary_title_text_size"
        android:textColor="@color/normal_card_text_secondary"
        android:id="@+id/first_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/from_station"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_item_value_text_size"
        android:textColor="@color/normal_card_text_primary"
        android:id="@+id/first_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_value_margin_top"
        app:layout_constraintBottom_toBottomOf="@+id/second_value"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/first_title"
        style="@style/smart_card_normal_text"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_item_secondary_title_text_size"
        android:textColor="@color/normal_card_text_secondary"
        android:id="@+id/second_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/from_station"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_item_value_text_size"
        android:textColor="@color/normal_card_text_primary"
        android:id="@+id/second_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_value_margin_top"
        app:layout_constraintBottom_toBottomOf="@+id/first_value"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/second_title"
        style="@style/smart_card_normal_text"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_item_secondary_title_text_size"
        android:textColor="@color/normal_card_text_secondary"
        android:id="@+id/third_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/first_value"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_item_value_text_size"
        android:textColor="@color/normal_card_text_primary"
        android:id="@+id/third_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_value_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/third_title"
        style="@style/smart_card_normal_text"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_item_secondary_title_text_size"
        android:textColor="@color/normal_card_text_secondary"
        android:id="@+id/four_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/second_value"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_item_value_text_size"
        android:textColor="@color/normal_card_text_primary"
        android:id="@+id/four_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_value_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/four_title"
        style="@style/smart_card_normal_text"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_item_primary_title_text_size"
        android:textColor="@color/normal_card_text_secondary"
        android:id="@+id/passenger_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/third_value"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textSize="@dimen/travel_card_item_value_text_size"
        android:textColor="@color/normal_card_text_primary"
        android:id="@+id/passenger_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_value_margin_top"
        android:maxEms="12"
        android:singleLine="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/passenger_title"/>
    <androidx.constraintlayout.widget.Group
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="from_station, from_time"/>
    <androidx.constraintlayout.widget.Group
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="arrive_station, arrive_time"/>
    <androidx.constraintlayout.widget.Group
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="first_title, first_value"/>
    <androidx.constraintlayout.widget.Group
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="second_title, second_value"/>
    <androidx.constraintlayout.widget.Group
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="third_title, third_value"/>
    <androidx.constraintlayout.widget.Group
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="four_title, four_value"/>
    <androidx.constraintlayout.widget.Group
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="passenger_title, passenger_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
