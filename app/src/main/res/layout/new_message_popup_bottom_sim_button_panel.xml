<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/sim_button_container"
    android:background="@drawable/new_message_popup_bottom_bg"
    android:paddingTop="10.91dp"
    android:paddingBottom="11.27dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="15dp"
    android:paddingEnd="15dp">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/sim_button1"
        android:background="@drawable/send_slot_btn_bg"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="4dp">
        <TextView
            android:id="@+id/sim_button1_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sim_card1"
            android:drawableStart="@drawable/sim1"
            style="@style/SimIndicatorTextStyle"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/sim_button2"
        android:background="@drawable/send_slot_btn_bg"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:id="@+id/sim_button2_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sim_card2"
            android:drawableStart="@drawable/sim2"
            style="@style/SimIndicatorTextStyle"/>
    </LinearLayout>
</LinearLayout>
