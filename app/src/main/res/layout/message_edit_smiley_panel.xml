<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/attachment_screen_bg"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/smiley_screens"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.android.mmt.ui.ScreenView
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.android.mmt.ui.ScreenView
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.android.mmt.ui.ScreenView
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.android.mmt.ui.ScreenView
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.android.mmt.ui.ScreenView
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:background="@drawable/smiley_tab_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TabWidget
            android:id="@+id/smiley_tab_widget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:divider="@null"
            android:tabStripLeft="@null"
            android:tabStripRight="@null"
            android:tabStripEnabled="false">
            <ImageButton
                android:gravity="center"
                android:background="@drawable/smiley_item_bg"
                android:layout_width="@dimen/smiley_item_width"
                android:layout_height="@dimen/smiley_item_height"
                android:src="@drawable/smiley_tab_image_smiley"
                android:contentDescription="@string/button_emoji_smiley"/>
            <ImageButton
                android:gravity="center"
                android:background="@drawable/smiley_item_bg"
                android:layout_width="@dimen/smiley_item_width"
                android:layout_height="@dimen/smiley_item_height"
                android:src="@drawable/smiley_tab_image_creature"
                android:contentDescription="@string/button_emoji_creature"/>
            <ImageButton
                android:gravity="center"
                android:background="@drawable/smiley_item_bg"
                android:layout_width="@dimen/smiley_item_width"
                android:layout_height="@dimen/smiley_item_height"
                android:src="@drawable/smiley_tab_image_lifestyle"
                android:contentDescription="@string/button_emoji_lifestyle"/>
            <ImageButton
                android:gravity="center"
                android:background="@drawable/smiley_item_bg"
                android:layout_width="@dimen/smiley_item_width"
                android:layout_height="@dimen/smiley_item_height"
                android:src="@drawable/smiley_tab_text"
                android:contentDescription="@string/button_emoji_text"/>
            <ImageButton
                android:gravity="center"
                android:background="@drawable/smiley_item_bg"
                android:layout_width="@dimen/smiley_item_width"
                android:layout_height="@dimen/smiley_item_height"
                android:src="@drawable/smiley_tab_symbol"
                android:contentDescription="@string/button_emoji_symbol"/>
        </TabWidget>
        <ImageButton
            android:gravity="center"
            android:id="@+id/smiley_back"
            android:background="@drawable/smiley_item_bg"
            android:layout_width="@dimen/smiley_item_width"
            android:layout_height="@dimen/smiley_item_height"
            android:src="@drawable/smiley_back"
            android:contentDescription="@string/delete"/>
    </LinearLayout>
</LinearLayout>
