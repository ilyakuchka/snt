<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/card_name_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/contact_card_title_height">
        <com.android.mmt.ui.StaticTextView
            android:textSize="@dimen/contact_card_title_text_size"
            android:textStyle="bold"
            android:textColor="@color/contact_card_title_text_color"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:autoLink="none"
            android:layout_gravity="center"
            android:id="@+id/card_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/contact_card_unknown_contact"
            android:maxLines="1"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/insert"
            android:visibility="gone"
            android:layout_width="@dimen/contact_card_insert_button_size"
            android:layout_height="@dimen/contact_card_insert_button_size"
            android:src="@drawable/ic_insert_contact"
            android:scaleType="centerCrop"
            android:contentDescription="@string/menu_add_contact"/>
    </LinearLayout>
    <View
        android:id="@+id/card_divider"
        android:background="@drawable/contact_card_divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/card_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
