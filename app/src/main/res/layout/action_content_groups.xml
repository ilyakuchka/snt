<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/action_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="11.6dp"
        app:layout_constraintBottom_toBottomOf="@+id/action_value"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_title"
        app:layout_constraintVertical_bias="0.5"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textAppearance="@style/TextAppearance.List.Secondary"
        android:textSize="@dimen/normal_card_action_title_text_size"
        android:textColor="@color/normal_card_text_secondary"
        android:id="@+id/action_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/action_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"
        style="@style/smart_card_normal_text"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Primary"
        android:textSize="@dimen/normal_card_action_value_text_size"
        android:textStyle="bold"
        android:textColor="@color/normal_card_text_primary"
        android:id="@+id/action_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/action_divider"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/action_title"
        app:layout_constraintTop_toBottomOf="@+id/action_title"
        style="@style/smart_card_normal_text"/>
    <Button
        android:textAppearance="@style/TextAppearance.MessageBody.In.Understand"
        android:background="@drawable/understand_button_card_single"
        android:paddingTop="@dimen/normal_card_action_btn_padding_v"
        android:paddingBottom="@dimen/normal_card_action_btn_padding_v"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/normal_card_action_btn_padding_h"
        android:paddingEnd="@dimen/normal_card_action_btn_padding_h"
        app:layout_constraintBottom_toTopOf="@+id/action_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/action_title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
    <ImageView
        android:id="@+id/action_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/card_body_divider"
        app:layout_constraintTop_toBottomOf="@+id/action_value"/>
</androidx.constraintlayout.widget.ConstraintLayout>
