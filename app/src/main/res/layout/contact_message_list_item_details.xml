<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.android.mmt.ui.StaticTextView
        android:textSize="@dimen/contact_card_item_title_text_size"
        android:textColor="@color/contact_card_item_title_text_color"
        android:ellipsize="end"
        android:autoLink="none"
        android:id="@+id/card_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/contact_card_item_padding_top"
        android:singleLine="true"
        android:textDirection="firstStrongLtr"
        app:layout_constraintEnd_toStartOf="@+id/arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/contact_card_item_tag_text_size"
        android:textColor="@color/contact_card_item_tag_text_color"
        android:ellipsize="end"
        android:id="@+id/card_tag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/contact_card_item_padding_bottom"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_text"/>
    <ImageView
        android:id="@+id/arrow"
        android:layout_width="@dimen/contact_card_insert_button_size"
        android:layout_height="@dimen/contact_card_insert_button_size"
        android:src="@drawable/contact_card_arrow_right"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/card_tag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/card_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
