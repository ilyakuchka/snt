<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/normal_indicator"
        android:background="@drawable/normal_card_indicator_bg"
        android:layout_width="4.4dp"
        android:layout_height="34.4sp"
        android:src="@android:color/holo_red_dark"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/normal_date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/normal_title"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Primary"
        android:textSize="@dimen/normal_card_normal_title_text_size"
        android:textStyle="bold"
        android:textColor="@color/normal_card_text_primary"
        android:id="@+id/normal_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="8.7dp"
        app:layout_constraintEnd_toStartOf="@+id/base_line"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/normal_indicator"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textAppearance="@style/TextAppearance.List.Secondary"
        android:textSize="@dimen/normal_card_normal_subtitle_text_size"
        android:textColor="@color/normal_card_text_secondary"
        android:ellipsize="end"
        android:id="@+id/normal_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.9dp"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/normal_divider"
        app:layout_constraintEnd_toStartOf="@+id/base_line"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/normal_indicator"
        app:layout_constraintStart_toStartOf="@+id/normal_title"
        app:layout_constraintTop_toBottomOf="@+id/normal_title"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/base_line"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Primary"
        android:textSize="@dimen/normal_card_normal_title_text_size"
        android:textStyle="bold"
        android:textColor="@color/normal_card_text_primary"
        android:ellipsize="middle"
        android:gravity="end"
        android:id="@+id/normal_title_right"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginEnd="8.7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/base_line"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.miui.smsextra.internal.ui.SizeCachedTextView
        android:textAppearance="@style/TextAppearance.List.Secondary"
        android:textSize="@dimen/normal_card_normal_subtitle_text_size"
        android:textColor="@color/normal_card_text_secondary"
        android:ellipsize="middle"
        android:gravity="end"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.9dp"
        android:maxEms="12"
        android:singleLine="true"
        android:layout_marginEnd="8.7dp"
        app:layout_constraintBottom_toTopOf="@+id/normal_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/base_line"
        app:layout_constraintTop_toBottomOf="@+id/normal_title_right"/>
    <TextView
        android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Primary"
        android:textSize="@dimen/normal_card_normal_value_text_size"
        android:textStyle="bold"
        android:textColor="@color/normal_card_text_primary"
        android:gravity="end"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/normal_date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/base_line"
        app:layout_constraintTop_toTopOf="@+id/normal_title"
        app:layout_constraintVertical_bias="0.5"/>
    <ImageView
        android:id="@+id/normal_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/card_body_divider"
        app:layout_constraintTop_toBottomOf="@+id/normal_date"/>
</androidx.constraintlayout.widget.ConstraintLayout>
