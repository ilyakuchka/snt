<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewStub
        android:id="@+id/service_category_title"
        android:layout="@layout/service_category_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.android.mmt.ui.DispatchFrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarStyle="insideOverlay"
            android:id="@android:id/list"
            android:fadingEdgeLength="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:drawSelectorOnTop="false"
            android:cacheColorHint="@null"
            android:divider="@null"
            android:splitMotionEvents="false"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/empty_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <ViewStub
                android:id="@+id/blank_view"
                android:layout="@layout/conversation_list_blank_view"
                android:inflatedId="@+id/blank_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.core.widget.NestedScrollView>
    </com.android.mmt.ui.DispatchFrameLayout>
</LinearLayout>
