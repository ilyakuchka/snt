<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/empty_view_top_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/no_conversations">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/blankview_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textAppearance="@style/TextAppearance.List.EmptyView"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/empty_str"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-10dp"
        android:text="@string/no_conversations"/>
</LinearLayout>
