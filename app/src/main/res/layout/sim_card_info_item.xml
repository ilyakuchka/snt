<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="?attr/listViewItemBackground"
    android:paddingTop="15dp"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/select_sim_item_min_height">
    <TextView
        android:textSize="@dimen/select_sim_text_size"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        style="@style/Widget.DropDownItem"/>
    <ImageView
        android:id="@+id/iv_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/select_sim_indicator_top_margin"
        android:src="@drawable/sim1_indicator"
        android:contentDescription="@null"
        android:layout_marginStart="5dp"
        android:layout_toEndOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/select_sim_sub_text_size"
        android:textColor="@color/sim_card_number_color"
        android:id="@+id/tv_sub_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_below="@+id/tv_title"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"/>
    <View
        android:id="@+id/v_bottom_divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="26.36dp"
        android:layout_below="@+id/tv_sub_info"/>
</RelativeLayout>
