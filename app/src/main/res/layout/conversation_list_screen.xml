<?xml version="1.0" encoding="utf-8"?>
<com.android.mmt.ui.DispatchFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/header_view"
            layout="@layout/miuix_appcompat_search_stub"/>
        <com.android.mmt.util.EditableListViewV2
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:splitMotionEvents="false"/>
        <FrameLayout
            android:id="@+id/empty_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <ViewStub
                android:id="@+id/blank_view"
                android:layout="@layout/conversation_list_blank_view"
                android:inflatedId="@+id/blank_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </LinearLayout>
    <miuix.miuixbasewidget.widget.FloatingActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/conversation_fab_margin"
        android:src="@drawable/miuix_appcompat_action_button_main_new"
        android:contentDescription="@string/new_message"
        android:layout_marginEnd="@dimen/conversation_fab_margin"
        app:fabColor="@color/fab_bg_color"/>
</com.android.mmt.ui.DispatchFrameLayout>
