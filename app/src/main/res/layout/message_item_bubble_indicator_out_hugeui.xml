<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/date_indicator_panel"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewStub
        android:layout_gravity="center_vertical"
        android:id="@+id/favorite_icon_panel"
        android:layout="@layout/favorite_icon_panel_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/btn_resend"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_sender_failed"
        android:contentDescription="@string/button_resend_message"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        layout="@layout/message_item_bubble_deliver_text"/>
    <ViewStub
        android:layout_gravity="center_vertical"
        android:id="@+id/group_send_icon"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout="@layout/message_item_bubble_group_send_icon_stub"
        android:inflatedId="@+id/group_send_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/status_divider"
        android:layout_marginLeft="5dp"
        style="@style/VerticalDividerStyle"/>
    <TextView
        android:id="@+id/message_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.MessageDesc.BubbleDate"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/message_slot_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:contentDescription="@null"/>
</LinearLayout>
