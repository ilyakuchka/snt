<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="?attr/listViewItemBackground"
    android:layout_width="match_parent"
    android:layout_height="?android:attr/listPreferredItemHeight"
    android:paddingStart="@dimen/list_item_padding_outer"
    android:paddingEnd="@dimen/list_item_padding_outer">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <view
            android:textAppearance="@style/TextAppearance.List.Primary"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            class="com.android.mmt.ui.SearchFragment$TextViewSnippet"/>
        <view
            android:textAppearance="@style/TextAppearance.List.Secondary"
            android:gravity="end"
            android:id="@+id/number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="2"
            android:layout_marginStart="7dp"
            class="com.android.mmt.ui.SearchFragment$TextViewSnippet"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/TextAppearance.List.Secondary"
        android:id="@+id/count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"/>
</LinearLayout>
