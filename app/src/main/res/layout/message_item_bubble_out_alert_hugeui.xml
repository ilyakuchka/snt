<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:id="@+id/message_item"
        android:background="@drawable/message_bubble_out_bg"
        android:inflatedId="@+id/name_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/bubble_special_margin"
        app:layout_constraintEnd_toEndOf="parent">
        <ViewStub
            android:id="@+id/group_send_to_panel"
            android:layout="@layout/group_send_to_panel_stub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="@dimen/bubble_text_extra_padding"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <include
            android:id="@+id/bubble_body"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_below="@+id/group_send_to_panel"
            android:layout_alignParentLeft="true"
            layout="@layout/message_item_bubble_out_alert_body"/>
        <com.android.mmt.ui.ThumbnailView
            android:id="@+id/attachment_preview"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:layout_toRightOf="@+id/bubble_body"
            android:layout_below="@+id/group_send_to_panel"/>
        <ViewStub
            android:id="@+id/group_send_failed_panel"
            android:layout="@layout/group_failed_panel_stub"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_below="@+id/bubble_body"
            android:layout_alignParentLeft="true"/>
        <ViewStub
            android:id="@+id/audio_item_stub"
            android:layout="@layout/audio_item_panel_out"
            android:layout_width="@dimen/audio_bubble_width"
            android:layout_height="@dimen/audio_bubble_height"/>
    </RelativeLayout>
    <ViewStub
        android:id="@+id/message_send_failed_tips"
        android:layout="@layout/message_send_failed_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="@dimen/bubble_date_indicator_right_margin"
        app:layout_constraintEnd_toEndOf="@+id/message_item"
        app:layout_constraintTop_toBottomOf="@+id/message_item"/>
</androidx.constraintlayout.widget.ConstraintLayout>
