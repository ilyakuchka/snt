<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:divider="@drawable/extra_vertical_divider"
    android:showDividers="middle">
    <FrameLayout
        android:id="@+id/btn_left"
        android:background="@drawable/understand_button_2"
        android:padding="0dp"
        android:paddingTop="@dimen/normal_card_action_btn_padding_v"
        android:paddingBottom="@dimen/normal_card_action_btn_padding_v"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:paddingLeft="5dp"
            android:paddingTop="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ADTag"/>
        <TextView style="@style/TextAppearance.MessageBody.In.Understand"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/btn_center"
        android:background="@drawable/understand_button_2"
        android:padding="0dp"
        android:paddingTop="@dimen/normal_card_action_btn_padding_v"
        android:paddingBottom="@dimen/normal_card_action_btn_padding_v"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:paddingLeft="5dp"
            android:paddingTop="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ADTag"/>
        <TextView style="@style/TextAppearance.MessageBody.In.Understand"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/btn_right"
        android:background="@drawable/understand_button_2"
        android:padding="0dp"
        android:paddingTop="@dimen/normal_card_action_btn_padding_v"
        android:paddingBottom="@dimen/normal_card_action_btn_padding_v"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <TextView
            android:paddingLeft="5dp"
            android:paddingTop="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ADTag"/>
        <TextView
            android:id="@+id/text_right"
            style="@style/TextAppearance.MessageBody.In.Understand"/>
    </FrameLayout>
</LinearLayout>
