<?xml version="1.0" encoding="utf-8"?>
<com.android.mmt.ui.MultipleRecipientsConversationHeader xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/contact_panel"
    android:background="@drawable/title_bar_tall_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/contact_panel_height"
    android:paddingEnd="10dp">
    <Button
        android:id="@+id/home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        style="@style/HomeButtonStyle"/>
    <ImageView
        android:id="@+id/image_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/show_contact_info_unchecked"
        android:contentDescription="@string/button_unfold"
        android:layout_marginStart="6dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Title"
        android:ellipsize="end"
        android:id="@+id/to_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:layout_toStartOf="@+id/image_arrow"
        android:layout_toEndOf="@+id/home"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Title.Secondary"
        android:id="@+id/to_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_below="@+id/to_title"
        android:textAlignment="viewStart"
        android:layout_toStartOf="@+id/image_arrow"
        android:layout_toEndOf="@+id/home"/>
</com.android.mmt.ui.MultipleRecipientsConversationHeader>
