<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="?attr/listViewItemBackground"
    android:layout_width="match_parent"
    android:layout_height="?android:attr/listPreferredItemHeight"
    android:paddingStart="@dimen/list_item_padding_outer"
    android:paddingEnd="@dimen/list_item_padding_outer">
    <view
        android:textAppearance="@style/TextAppearance.List.Primary"
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        class="com.android.mmt.ui.SearchFragment$TextViewSnippet"/>
    <view
        android:textAppearance="@style/TextAppearance.List.Secondary"
        android:id="@+id/number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        class="com.android.mmt.ui.SearchFragment$TextViewSnippet"/>
</LinearLayout>
