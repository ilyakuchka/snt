<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/list_item_padding_outer"
    android:paddingEnd="@dimen/list_item_padding_outer">
    <TextView
        android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Primary"
        android:textStyle="bold"
        android:textColor="?attr/textColorList"
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_vertical_margin"
        android:layout_marginBottom="@dimen/item_vertical_margin"
        android:singleLine="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_vertical_margin"
        android:layout_marginBottom="@dimen/item_vertical_margin">
        <view
            android:textAppearance="@style/TextAppearance.List.Secondary"
            android:id="@+id/message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            class="com.android.mmt.ui.SearchFragment$TextViewSnippet"/>
        <TextView
            android:textAppearance="@style/TextAppearance.List.Secondary"
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/expand_text_size"
        android:textStyle="bold"
        android:textColor="@color/highlight_text_color"
        android:id="@+id/expander"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_vertical_margin"
        android:layout_marginBottom="@dimen/item_vertical_margin"
        android:text="@string/search_show_more_results"/>
    <View
        android:id="@+id/divider"
        android:background="@drawable/conversation_message_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/item_vertical_margin"
        android:layout_marginBottom="@dimen/item_vertical_margin"/>
</LinearLayout>
