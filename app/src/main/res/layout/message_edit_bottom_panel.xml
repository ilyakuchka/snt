<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:layout_gravity="bottom"
    android:id="@+id/bottom_panel"
    android:background="@drawable/message_edit_bottom_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/bottom_editor_panel_min_height"
    android:layout_alignParentBottom="true">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_editor_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:splitMotionEvents="false">
        <ImageButton
            android:layout_gravity="bottom"
            android:id="@+id/switch_btn"
            android:background="@null"
            android:layout_width="@dimen/button_bottom_panel_add_attachment_width"
            android:layout_height="@dimen/button_bottom_panel_add_attachment_width"
            android:layout_marginBottom="@dimen/button_bottom_panel_add_attachment_margin"
            android:src="@drawable/insert_attachment_button_n"
            android:scaleType="fitCenter"
            android:contentDescription="@string/add_attachment"
            android:layout_marginStart="@dimen/button_bottom_panel_add_attachment_margin_start"/>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/bottom_editor"
            android:background="@drawable/compose_message_editor_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bottom_editor_margin"
            android:layout_marginBottom="@dimen/bottom_editor_margin"
            android:baselineAligned="false"
            android:layout_weight="1"
            android:splitMotionEvents="false"
            android:layout_marginStart="@dimen/bottom_editor_margin_left">
            <com.android.mmt.ui.ChildClickableFrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/editor_audio_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <include
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    layout="@layout/mms_editor"/>
                <ViewStub
                    android:id="@+id/message_bottom_audio_button"
                    android:layout="@layout/message_edit_bottom_panel_audio_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bottom_editor_height"/>
            </com.android.mmt.ui.ChildClickableFrameLayout>
        </LinearLayout>
        <com.android.mmt.ui.ChildClickableRelativeLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/send_button_group"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/button_bottom_panel_add_attachment_margin"
            android:layoutDirection="ltr"
            android:layout_marginStart="@dimen/bottom_editor_margin_left"
            android:layout_marginEnd="@dimen/button_bottom_panel_add_attachment_end">
            <TextView
                android:textAppearance="@style/TextAppearance.MessageCounter"
                android:id="@+id/text_counter"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layoutDirection="locale"/>
            <Button
                android:id="@+id/send_button"
                android:background="@drawable/send_btn"
                android:nextFocusLeft="@+id/embedded_text_editor"
                android:layout_width="@dimen/button_bottom_panel_add_attachment_width"
                android:layout_height="@dimen/button_bottom_panel_add_attachment_width"
                android:layout_below="@+id/text_counter"
                android:contentDescription="@string/send_sms"
                android:layoutDirection="locale"/>
            <ViewStub
                android:id="@+id/exit_audio_record_button"
                android:layout="@layout/message_edit_bottom_panel_audio_record"
                android:layout_width="@dimen/button_bottom_panel_add_attachment_width"
                android:layout_height="@dimen/button_bottom_panel_add_attachment_width"/>
        </com.android.mmt.ui.ChildClickableRelativeLayout>
    </LinearLayout>
    <ViewStub
        android:layout="@layout/message_edit_bottom_menu_stub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
