<?xml version="1.0" encoding="utf-8"?>
<com.android.mmt.ui.BookmarkListItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:addStatesFromChildren="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/BookmarkListItem">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/msg_info_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tab_header_margin"
        android:layout_marginEnd="@dimen/tab_header_margin">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <TextView
                android:ellipsize="middle"
                android:gravity="start"
                android:id="@+id/message_sender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="120dp"
                android:singleLine="true"
                android:textDirection="locale"
                android:textAlignment="viewStart"
                android:layout_marginEnd="5dp"
                android:layout_alignParentStart="true"
                style="@style/TextAppearance.MessageDesc.BookmarkTitle"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/message_sender"
                android:layout_alignParentEnd="true">
                <TextView
                    android:ellipsize="start"
                    android:gravity="end"
                    android:id="@+id/favorite_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_weight="1"
                    style="@style/TextAppearance.MessageDesc.BookmarkDate"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/message_slot_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    android:layout_marginStart="3dp"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/bookmark_card"
        android:background="@drawable/message_bubble_in_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/msg_info_layout"
        android:layout_marginStart="@dimen/card_margin_start"
        android:layout_marginEnd="@dimen/card_margin_end"
        app:cardBackgroundColor="@color/new_card_body_bg"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/attachment_image"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/bookmark_image_height"
                android:scaleType="centerCrop"
                android:contentDescription="@string/attach_image"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/message_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/card_padding"
                android:layout_below="@+id/attachment_image">
                <ImageView
                    android:id="@+id/attachment_icon"
                    android:visibility="gone"
                    android:layout_width="@dimen/bookmark_icon_size"
                    android:layout_height="@dimen/bookmark_icon_size"
                    android:scaleType="centerInside"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <TextView
                    android:gravity="center_vertical"
                    android:linksClickable="false"
                    android:id="@+id/message_subject"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="@dimen/message_body_line_spacing_multiplier"
                    android:layout_marginStart="@dimen/bookmark_subject_margin_start"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/attachment_icon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_goneMarginStart="0dp"
                    style="@style/TextAppearance.MessageDesc.BookmarkTitle"/>
                <com.android.mmt.ui.ExpandableTextView
                    android:textColor="@color/normal_card_text_secondary"
                    android:autoLink="phone|email|web"
                    android:linksClickable="false"
                    android:id="@+id/message_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/bookmark_body_margin_top"
                    android:maxLines="7"
                    android:lineSpacingMultiplier="@dimen/message_body_line_spacing_multiplier"
                    android:textDirection="firstStrongLtr"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/message_subject"
                    app:layout_goneMarginTop="0dp"
                    style="@style/TextAppearance.MessageDesc.BookmarkBody"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contact_message_body"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bookmark_content_margin_top"
        android:layout_below="@+id/msg_info_layout"
        android:layout_marginStart="@dimen/card_margin_start"
        android:layout_marginEnd="@dimen/card_margin_end"/>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/bubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/msg_info_layout"
        android:layout_marginStart="@dimen/bubble_sms_card_margin_start"
        android:layout_marginEnd="@dimen/bubble_sms_card_margin_end"/>
</com.android.mmt.ui.BookmarkListItem>
