<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/listViewItemBackground"
    android:paddingTop="@dimen/list_item_padding_top"
    android:paddingBottom="@dimen/list_item_padding_bottom"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/unread_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/status_unread"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.android.mmt.ui.StaticTextView
        android:textAppearance="@style/TextAppearance.List.Primary.Conversation"
        android:ellipsize="end"
        android:id="@+id/from"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="firstStrongLtr"
        android:paddingEnd="130dp"
        app:layout_constraintBottom_toTopOf="@+id/subject"
        app:layout_constraintEnd_toStartOf="@+id/date"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/subject"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ViewStub
        android:id="@+id/indicator_container"
        android:layout="@layout/conversation_list_item_indicator_container"
        android:inflatedId="@+id/indicator_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/date"
        app:layout_constraintEnd_toStartOf="@+id/date"
        app:layout_constraintTop_toTopOf="@+id/date"/>
    <com.android.mmt.ui.StaticTextView
        android:textSize="@dimen/datetime_text_size"
        android:textColor="@color/conversation_date_color"
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingStart="@dimen/conversation_indicator_margin"
        app:layout_constraintBaseline_toBaselineOf="@+id/from"
        app:layout_constraintEnd_toStartOf="@+id/sim_indicator"/>
    <ViewStub
        android:id="@+id/sim_indicator"
        android:layout="@layout/conversation_list_item_indicator"
        android:inflatedId="@+id/sim_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/date"
        app:layout_constraintEnd_toStartOf="@+id/sub_sim_tip"
        app:layout_constraintTop_toTopOf="@+id/date"/>
    <ViewStub
        android:id="@+id/sub_sim_tip"
        android:layout="@layout/conversation_list_item_sub_sim"
        android:inflatedId="@+id/sub_sim_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/conversation_sub_indicator_margin"
        app:layout_constraintBottom_toBottomOf="@+id/date"
        app:layout_constraintEnd_toStartOf="@+id/end_holder"
        app:layout_constraintTop_toTopOf="@+id/date"/>
    <View
        android:id="@+id/end_holder"
        android:visibility="invisible"
        android:layout_width="1px"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/date"/>
    <com.android.mmt.ui.StaticTextView
        android:textAppearance="@style/TextAppearance.List.Secondary.Conversation"
        android:ellipsize="end"
        android:id="@+id/subject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/list_item_subject_padding"
        android:layout_marginBottom="@dimen/list_item_subject_padding"
        android:maxLines="2"
        android:textDirection="firstStrongLtr"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="@dimen/list_item_subject_margin_end"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/end_holder"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/unread_indicator"
        app:layout_constraintTop_toBottomOf="@+id/from"
        app:layout_goneMarginStart="0dp"/>
    <ViewStub
        android:id="@android:id/checkbox"
        android:layout="@layout/conversation_list_item_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/conversation_checkbox_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/end_holder"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
