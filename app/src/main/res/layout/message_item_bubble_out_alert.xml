<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:id="@+id/message_item"
        android:background="@drawable/message_bubble_out_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent">
        <ViewStub
            android:id="@+id/group_send_to_panel"
            android:layout="@layout/group_send_to_panel_stub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="@dimen/bubble_text_extra_padding"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <include
            android:id="@+id/bubble_body"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_below="@+id/group_send_to_panel"
            android:layout_alignParentLeft="true"
            layout="@layout/message_item_bubble_out_alert_body"/>
        <com.android.mmt.ui.ThumbnailView
            android:id="@+id/attachment_preview"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:layout_toRightOf="@+id/bubble_body"
            android:layout_below="@+id/group_send_to_panel"/>
        <ViewStub
            android:id="@+id/group_send_failed_panel"
            android:layout="@layout/group_failed_panel_stub"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_below="@+id/bubble_body"
            android:layout_alignParentLeft="true"/>
        <ViewStub
            android:id="@+id/audio_item_stub"
            android:layout="@layout/audio_item_panel_out"
            android:layout_width="@dimen/audio_bubble_width"
            android:layout_height="@dimen/audio_bubble_height"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/status_container"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/message_item"
        app:layout_constraintRight_toLeftOf="@+id/message_item"
        app:layout_constraintTop_toTopOf="@+id/message_item">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/btn_resend"
            android:paddingLeft="@dimen/bubble_message_resend_padding_h"
            android:paddingTop="@dimen/bubble_message_resend_padding_v"
            android:paddingRight="@dimen/bubble_message_resend_padding_h"
            android:paddingBottom="@dimen/bubble_message_resend_padding_v"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_sender_failed"
            android:contentDescription="@string/resent_message"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/deliver_status_text"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:maxLines="1"
            style="@style/TextAppearance.MessageDesc.Deliver.Alert"/>
    </FrameLayout>
    <ViewStub
        android:layout="@layout/message_send_failed_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="@dimen/bubble_date_indicator_right_margin"
        app:layout_constraintEnd_toEndOf="@+id/message_item"
        app:layout_constraintTop_toBottomOf="@+id/message_item"/>
    <ViewStub
        android:id="@+id/favorite_icon_panel"
        android:layout="@layout/favorite_icon_panel_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="-7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/status_container"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
