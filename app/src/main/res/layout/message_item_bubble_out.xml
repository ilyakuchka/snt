<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <RelativeLayout
        android:id="@+id/message_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent">
        <View
            android:id="@+id/timed_message_padding_view"
            android:background="@null"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:longClickable="false"
            android:layout_width="@dimen/timed_message_padding_width"
            android:layout_height="1px"
            android:layout_alignParentLeft="true"/>
        <ViewStub
            android:layout_gravity="right"
            android:id="@+id/group_send_to_panel"
            android:layout="@layout/group_send_to_panel_stub"
            android:inflatedId="@+id/group_send_to_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"/>
        <include
            android:id="@+id/bubble_body"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/timed_message_padding_view"
            android:layout_below="@+id/group_send_to_panel"
            layout="@layout/message_item_bubble_out_body"/>
        <com.android.mmt.ui.ThumbnailView
            android:id="@+id/attachment_preview"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:layout_toRightOf="@+id/bubble_body"
            android:layout_below="@+id/group_send_to_panel"
            android:contentDescription="@string/type_picture"/>
        <ViewStub
            android:id="@+id/audio_item_stub"
            android:layout="@layout/audio_item_panel_out"
            android:layout_width="@dimen/audio_bubble_width"
            android:layout_height="@dimen/audio_bubble_height"/>
    </RelativeLayout>
    <ViewStub
        android:id="@+id/timed_message_indicator_stub"
        android:layout="@layout/timed_message_indicator_stub"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/message_item"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintLeft_toLeftOf="@+id/message_item"
        app:layout_constraintTop_toTopOf="@+id/message_item"/>
    <ViewStub
        android:id="@+id/group_send_icon"
        android:layout="@layout/message_item_bubble_group_send_icon_stub"
        android:inflatedId="@+id/group_send_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="6dp"
        app:layout_constraintRight_toLeftOf="@+id/message_item"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_below="@+id/group_send_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/message_item"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/message_item_bubble_deliver_text"/>
    <ViewStub
        android:id="@+id/favorite_icon_panel"
        android:layout="@layout/favorite_icon_panel_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/deliver_status_text"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
