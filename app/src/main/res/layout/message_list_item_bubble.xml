<?xml version="1.0" encoding="utf-8"?>
<com.android.mmt.ui.MessageListItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bubble_top_margin_minimum"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bubble_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:layout_gravity="left"
            android:id="@+id/message_item_bubble_in_date_indicator_stub"
            android:layout="@layout/message_item_bubble_indicator_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/bubble_date_indicator_left_margin"
            android:layout_marginTop="@dimen/bubble_indicator_top_margin"/>
        <ViewStub
            android:layout_gravity="right"
            android:id="@+id/message_item_bubble_out_date_indicator_stub"
            android:layout="@layout/message_item_bubble_indicator_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bubble_indicator_top_margin"
            android:layout_marginRight="@dimen/bubble_date_indicator_right_margin"/>
        <ViewStub
            android:id="@+id/message_item_bubble_in_stub"
            android:layout="@layout/message_item_bubble_in_with_ad_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/message_item_bubble_out_stub"
            android:layout="@layout/message_item_bubble_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/message_item_bubble_out_alert_stub"
            android:layout="@layout/message_item_bubble_out_alert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ViewStub
        android:id="@+id/checkbox_container"
        android:layout="@layout/message_list_item_bubble_checkbox"
        android:layout_width="@dimen/check_box_width"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/bubble"
        android:layout_alignBottom="@+id/bubble"
        android:layout_alignParentEnd="true"/>
    <ViewStub
        android:layout="@layout/fake_cell_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/bubble"
        android:layout_centerHorizontal="true"/>
</com.android.mmt.ui.MessageListItem>
