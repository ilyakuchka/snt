<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="1px"
    android:paddingBottom="1px"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="1px"
    android:paddingEnd="1px">
    <TextView
        android:textSize="@dimen/dialog_primary_text_size"
        android:textColor="@color/dialog_primary_text"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/datetime_picker_dialog_title_margin_top"
        android:layout_marginBottom="@dimen/datetime_picker_dialog_title_margin_bottom"
        android:fontFamily="miui-bold"/>
    <TextView
        android:textSize="@dimen/dialog_sub_title_text_size"
        android:textColor="@color/dialog_secondary_text"
        android:layout_gravity="center_horizontal"
        android:id="@+id/datetime"
        android:paddingBottom="@dimen/datetime_picker_dialog_sub_title_margin_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <miuix.pickerwidget.widget.DateTimePicker
        android:orientation="vertical"
        android:id="@+id/time_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
