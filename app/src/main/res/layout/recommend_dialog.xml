<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="1px"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="27dp"
    android:paddingEnd="27dp">
    <ImageView
        android:id="@+id/img_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/sms_recommend_dialog_txt_color"
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_below="@+id/img_view"
        android:textAlignment="viewStart"
        style="?android:attr/textAppearanceMedium"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/permission_item_primary_vertical_margin"
        android:layout_below="@+id/message"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="2dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/txt_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/dialog_primary_text_size"
                android:textStyle="bold"
                android:textColor="@color/dialog_primary_text"
                android:id="@+id/mx_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mx_msg"
                android:singleLine="false"
                android:textAlignment="viewStart"/>
            <TextView
                android:textSize="@dimen/dialog_secondary_text_size"
                android:textColor="@color/recommend_dialog_summary_color"
                android:id="@+id/mx_summary0"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/recommend_tip_2"
                android:singleLine="false"
                android:textAlignment="viewStart"/>
            <TextView
                android:textSize="@dimen/dialog_secondary_text_size"
                android:textColor="@color/recommend_dialog_summary_color"
                android:id="@+id/mx_summary1"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/permission_primary_text_margin"
                android:text="@string/recommend_tip_3"
                android:singleLine="false"
                android:textAlignment="viewStart"/>
            <TextView
                android:textSize="@dimen/dialog_primary_text_size"
                android:textStyle="bold"
                android:textColor="@color/dialog_primary_text"
                android:id="@+id/smart_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/recommend_free_smart_server"
                android:singleLine="false"
                android:textAlignment="viewStart"/>
            <TextView
                android:textSize="@dimen/dialog_secondary_text_size"
                android:textColor="@color/recommend_dialog_summary_color"
                android:id="@+id/smart_summary0"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/recommend_tip_4"
                android:singleLine="false"
                android:textAlignment="viewStart"/>
            <TextView
                android:textSize="@dimen/dialog_secondary_text_size"
                android:textColor="@color/recommend_dialog_summary_color"
                android:id="@+id/smart_summary1"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/permission_primary_text_margin"
                android:text="@string/recommend_tip_5"
                android:singleLine="false"
                android:textAlignment="viewStart"/>
            <TextView
                android:textSize="@dimen/recommend_message_text_size"
                android:textColor="@color/recommend_bar_message_color"
                android:id="@+id/recommend_mg"
                android:paddingTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recommend_tip_6"
                android:textDirection="locale"
                android:textAlignment="viewStart"/>
            <TextView
                android:textSize="@dimen/recommend_message_text_size"
                android:textColor="@color/recommend_bar_message_color"
                android:id="@+id/recommend_message"
                android:paddingBottom="@dimen/recommend_message_padding_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recommend_tip_9"
                android:textDirection="locale"
                android:textAlignment="viewStart"/>
            <Button
                android:textSize="15.33dp"
                android:textColor="@color/miuix_appcompat_white"
                android:id="@+id/turnOn"
                android:background="@drawable/dialog_turn_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/turn_on"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/downlink_ignore_text_size"
                    android:textColor="@color/downlink_ignore_text_color"
                    android:gravity="center"
                    android:autoLink="all"
                    android:layout_gravity="center"
                    android:id="@+id/ignore"
                    android:padding="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/ignore"
                    android:textDirection="locale"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
