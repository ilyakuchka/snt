<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.android.mmt.ui.SizeAwareLinearLayout
        android:orientation="vertical"
        android:id="@+id/msg_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:splitMotionEvents="false">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_above="@+id/bottom_panel">
            <include layout="@layout/message_list"/>
            <include layout="@layout/message_edit_bottom_panel"/>
        </RelativeLayout>
        <ViewStub
            android:id="@+id/message_edit_attachment_stub"
            android:layout="@layout/message_edit_attachment_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.android.mmt.ui.SizeAwareLinearLayout>
</merge>
