<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:screenReaderFocusable="true">
    <com.android.mmt.ads.views.RoundedImageView
        android:id="@+id/native_icon_image"
        android:focusable="false"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:src="@drawable/message_attachment_default"
        android:scaleType="fitXY"
        app:bottom_left_corner_radius="12dp"
        app:bottom_right_corner_radius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="12dp"
        app:top_left_corner_radius="12dp"
        app:top_right_corner_radius="12dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#66000000"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/native_title"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/native_icon_image"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/native_title">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/base_line"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="21dp"/>
        <ImageView
            android:id="@+id/image_hot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ad_app_hot"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/base_line"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.android.mmt.ads.views.GradientTextView
            android:textSize="10sp"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/text_hot"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hot"
            android:singleLine="true"
            app:gradient_endColor="#ffff6f1e"
            app:gradient_startColor="#ffff9e22"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/base_line"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/image_top"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ad_app_top"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/base_line"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.android.mmt.ads.views.GradientTextView
            android:textSize="10sp"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/text_top"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Top"
            android:singleLine="true"
            app:gradient_endColor="#ff05c575"
            app:gradient_startColor="#ff03f08d"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/base_line"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
