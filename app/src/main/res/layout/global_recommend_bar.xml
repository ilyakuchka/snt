<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/recommend_content"
        android:background="@drawable/recommend_bar_home_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/recommend_bar_margin_top"
        android:layout_marginBottom="@dimen/recommend_bar_margin_bottom"
        android:layout_marginStart="@dimen/recommend_bar_margin_start"
        android:layout_marginEnd="@dimen/recommend_bar_margin_end">
        <TextView
            android:textSize="@dimen/recommend_title_text_size"
            android:textStyle="bold"
            android:textColor="@color/recommend_bar_title_color"
            android:id="@+id/recommend_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mx_msg"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/recommend_bar_title_color"
            android:id="@+id/recommend_summary0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/recommend_tip_2"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/recommend_bar_title_color"
            android:id="@+id/recommend_summary1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/recommend_tip_3"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="@dimen/recommend_title_text_size"
            android:textStyle="bold"
            android:textColor="@color/recommend_bar_title_color"
            android:id="@+id/recommend_title1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/recommend_free_smart_server"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/recommend_bar_title_color"
            android:id="@+id/recommend_summary2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/recommend_tip_10"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="@dimen/recommend_message_text_size"
            android:textColor="@color/recommend_bar_message_color"
            android:id="@+id/recommend_mg0"
            android:paddingTop="@dimen/recommend_message_padding_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recommend_tip_6"
            android:textDirection="locale"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="@dimen/recommend_message_text_size"
            android:textColor="@color/recommend_bar_message_color"
            android:id="@+id/recommend_message"
            android:paddingBottom="@dimen/recommend_message_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recommend_tip_9"
            android:textDirection="locale"
            android:textAlignment="viewStart"/>
        <Button
            android:textSize="@dimen/recommend_ok_text_size"
            android:textStyle="bold"
            android:textColor="@color/text_color_secondary_inverse"
            android:id="@+id/recommend_ok"
            android:background="@drawable/recommend_btn_bg_ok"
            android:layout_width="match_parent"
            android:layout_height="46.67dp"
            android:text="@string/recommend_agree"/>
        <Button
            android:textSize="13sp"
            android:textColor="@color/recommend_bar_message_color"
            android:gravity="center"
            android:id="@+id/recommend_close"
            android:background="@color/recommend_bar_button_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/recommend_disagree"/>
    </LinearLayout>
</LinearLayout>
