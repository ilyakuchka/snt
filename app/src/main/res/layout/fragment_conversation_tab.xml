<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/miuix_appcompat_search_stub"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:splitMotionEvents="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_view"/>
    <ViewStub
        android:id="@+id/blank_view"
        android:layout="@layout/conversation_list_blank_view"
        android:inflatedId="@+id/blank_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <miuix.miuixbasewidget.widget.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/conversation_fab_margin"
        android:src="@drawable/miuix_appcompat_action_button_main_new"
        android:contentDescription="@string/new_message"
        android:layout_marginEnd="@dimen/conversation_fab_margin"
        app:fabColor="@color/fab_bg_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
