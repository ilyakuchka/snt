<?xml version="1.0" encoding="utf-8"?>
<com.android.mmt.ui.MessageListItem xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/ListItem">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/message_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/checkbox_container"
        android:layout_alignParentStart="true">
        <com.android.mmt.ui.ShrinkableLinearLayout xmlns:mms="http://schemas.android.com/apk/res/com.android.mmt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            mms:shrinkableIndex="0">
            <TextView
                android:ellipsize="end"
                android:id="@+id/message_sender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginEnd="3dp"
                style="@style/TextAppearance.MessageDesc"/>
            <TextView
                android:id="@+id/message_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.MessageDesc"/>
            <TextView
                android:id="@+id/group_send_to"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                style="@style/TextAppearance.MessageDesc"/>
            <TextView
                android:id="@+id/deliver_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                style="@style/TextAppearance.MessageDesc"/>
        </com.android.mmt.ui.ShrinkableLinearLayout>
        <ViewStub
            android:id="@+id/message_item_list_stub"
            android:layout="@layout/message_item_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ViewStub
        android:id="@+id/checkbox_container"
        android:layout="@layout/message_list_item_bubble_checkbox"
        android:inflatedId="@+id/checkbox_container"
        android:layout_width="@dimen/check_box_width"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/message_main"
        android:layout_alignBottom="@+id/message_main"
        android:layout_alignParentEnd="true"/>
</com.android.mmt.ui.MessageListItem>
