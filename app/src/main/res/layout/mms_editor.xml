<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:id="@+id/editor_container"
    android:addStatesFromChildren="true"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/mms_editor_height"
    android:layout_weight="1"
    android:showDividers="middle">
    <FrameLayout
        android:addStatesFromChildren="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layoutDirection="locale">
        <ScrollView
            android:layout_gravity="center_vertical"
            android:scrollbars="none"
            android:fadingEdge="none"
            android:addStatesFromChildren="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">
            <RelativeLayout
                android:gravity="center_vertical"
                android:id="@+id/message_content_panel"
                android:paddingTop="@dimen/mms_editor_margin_top"
                android:paddingBottom="@dimen/mms_editor_margin_bottom"
                android:addStatesFromChildren="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/mms_editor_margin_left">
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/timed_desc"
                    android:background="@drawable/timing_button"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mms_editor_margin_item_margin"
                    android:layout_marginBottom="@dimen/mms_editor_margin_item_margin"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentStart="true"
                    style="@style/TextAppearance.EditText.TimeDesc"/>
                <EditText
                    android:id="@+id/subject"
                    android:background="@null"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mms_editor_margin_item_margin"
                    android:layout_marginBottom="@dimen/mms_editor_margin_item_margin"
                    android:hint="@string/subject_hint"
                    android:maxLength="41"
                    android:capitalize="sentences"
                    android:autoText="true"
                    android:layout_below="@+id/timed_desc"
                    style="@style/TextAppearance.EditText"/>
                <View
                    android:id="@+id/subject_divider"
                    android:background="@color/border_color"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0px"
                    android:layout_below="@+id/subject"/>
                <com.android.mmt.ui.AttachmentView
                    android:id="@+id/attachment_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mms_editor_margin_item_margin"
                    android:layout_marginBottom="@dimen/mms_editor_margin_item_margin"
                    android:layout_below="@+id/subject_divider"
                    android:layout_alignStart="@+id/subject_divider">
                    <com.android.mmt.ui.ThumbnailView
                        android:id="@+id/attachment_image"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/play_icon"
                        android:visibility="gone"
                        android:duplicateParentState="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/play_icon"
                        android:contentDescription="@string/play"/>
                </com.android.mmt.ui.AttachmentView>
                <TextView
                    android:id="@+id/audio_name"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mms_editor_margin_item_margin"
                    android:layout_marginBottom="@dimen/mms_editor_margin_item_margin"
                    android:layout_below="@+id/attachment_view"
                    android:layout_alignStart="@+id/subject_divider"
                    style="@style/TextAppearance.EditText.TimeDesc"/>
                <View
                    android:id="@+id/text_focuser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/subject_divider"
                    android:layout_alignTop="@+id/attachment_view"
                    android:layout_alignBottom="@+id/attachment_view"
                    android:importantForAccessibility="no"
                    android:layout_toEndOf="@+id/attachment_view"/>
                <com.android.mmt.ui.MmsTextEditor
                    android:textSize="@dimen/message_body_text_font_size"
                    android:id="@+id/embedded_text_editor"
                    android:background="@null"
                    android:nextFocusRight="@+id/send_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/mms_editor_margin_item_margin"
                    android:layout_marginBottom="@dimen/mms_editor_margin_item_margin"
                    android:maxLines="@integer/mms_text_editor_max_lines"
                    android:singleLine="false"
                    android:capitalize="sentences"
                    android:autoText="true"
                    android:layout_below="@+id/audio_name"
                    android:imeOptions="flagNoEnterAction|actionSend"
                    android:textAlignment="viewStart"
                    android:paddingStart="@dimen/mms_editor_start_padding"
                    android:paddingEnd="@dimen/mms_editor_end_padding"
                    style="@style/TextAppearance.EditText.Editor"/>
            </RelativeLayout>
        </ScrollView>
    </FrameLayout>
    <ViewStub
        android:layout="@layout/mms_editor_send_tv"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/send_slot_id"
        android:layout="@layout/mms_editor_slot_iv"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginBottom="15dp"/>
</LinearLayout>
