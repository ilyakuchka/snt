<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@drawable/group_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="200dp"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/TextAppearance.MessageBody.Alert"
            android:ellipsize="end"
            android:id="@+id/contact_info_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.MessageBody.Alert.Secondary"
            android:id="@+id/contact_info_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <CheckBox
        android:id="@+id/contact_info_checked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:layout_marginStart="5dp"/>
</LinearLayout>
