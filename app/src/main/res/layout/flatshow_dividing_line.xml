<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingEnd="10dp">
    <TextView
        android:id="@+id/page_no"
        android:background="@drawable/flatshow_page_index_gb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        style="@style/TextAppearance.FlatshowPageNo"/>
    <View
        android:background="@drawable/flatshow_dashline_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/flatshow_divider_margin_v"
        android:layout_marginBottom="@dimen/flatshow_divider_margin_v"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/page_no"/>
</RelativeLayout>
