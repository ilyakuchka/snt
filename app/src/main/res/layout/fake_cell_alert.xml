<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center"
        android:background="@drawable/security_alert_bg"
        android:layout_width="@dimen/security_alert_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/security_alert_margin"
        android:layout_marginBottom="@dimen/security_alert_margin"
        android:minHeight="36dp">
        <TextView
            android:textColorLink="@color/security_alert_color"
            android:gravity="start|center_vertical"
            android:layout_gravity="center"
            android:background="@null"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:text="@string/fake_cell_alert_hint"
            android:drawablePadding="9dp"
            style="@style/SecurityAlertTextStyle"/>
    </FrameLayout>
</FrameLayout>
