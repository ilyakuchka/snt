<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:title="@string/pref_notification_settings_title"
        android:key="pref_key_notification_settings">
        <CheckBoxPreference
            android:persistent="false"
            android:title="@string/pref_title_notification_body_enabled"
            android:key="pref_key_enable_notification_body"
            android:summary="@string/pref_summary_notification_body_enabled"
            android:defaultValue="true"/>
        <CheckBoxPreference
            android:title="@string/pref_title_delivery_reports"
            android:key="pref_key_delivery_reports"
            android:summary="@string/pref_summary_delivery_reports"/>
        <CheckBoxPreference
            android:title="@string/pref_title_send_delivery_reports"
            android:key="pref_key_send_delivery_reports"
            android:summary="@string/pref_summary_send_delivery_reports"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/pref_delivery_ringtone"
            android:key="pref_key_delivery_ringtone"
            android:summary="@string/pref_summary_delivery_ringtone"
            android:defaultValue="true"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/pref_other_title"
        android:key="pref_other_settings">
        <miuix.preference.TextPreference
            android:title="@string/pref_cell_broadcast"
            android:key="pref_cell_broadcast"/>
        <miuix.preference.TextPreference
            android:title="@string/block_messaging_entry_title"
            android:key="pref_key_block_messaging_entry">
            <intent
                android:targetPackage="com.android.mmt"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.mmt.util.BlockedParticipantsActivity"/>
        </miuix.preference.TextPreference>
        <CheckBoxPreference
            android:title="@string/title_use_gsm_alphabet"
            android:key="pref_key_use_gsm_alphabet"
            android:defaultValue="true"/>
        <PreferenceScreen
            android:title="@string/pref_advanced_settings_title"
            android:key="pref_advanced_settings">
            <intent
                android:targetPackage="com.android.mmt"
                android:action="android.intent.action.MAIN"
                android:targetClass="com.android.mmt.ui.MessagingAdvancedPreferenceActivity"/>
        </PreferenceScreen>
    </PreferenceCategory>
</PreferenceScreen>
